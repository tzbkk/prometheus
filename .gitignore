/data/
/log/
/output/
/archives/
# deepbackfill live credentials (p_skey) — template stays tracked
/conf/deepbackfill.conf.json
__pycache__/
*.pyc
*.egg-info/
.coverage
*.log
/db/
.sisyphus/
guild1.db
.venv/
